{
  "$defs": {
    "BundleManifest": {
      "properties": {
        "schema_version": {
          "default": "0.2",
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "pipeline": {
          "$ref": "#/$defs/PipelineInfo"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceSnapshot"
          },
          "type": "array"
        },
        "attribution": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Logical name -> file name within the bundle directory",
          "type": "object"
        },
        "summary": {
          "$ref": "#/$defs/RouteSummary"
        },
        "finding_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Count per severity",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "created_at",
        "pipeline",
        "route",
        "sources",
        "attribution",
        "files",
        "summary",
        "finding_counts"
      ],
      "type": "object",
      "title": "BundleManifest"
    },
    "Climb": {
      "properties": {
        "from_m": {
          "type": "number"
        },
        "to_m": {
          "type": "number"
        },
        "length_m": {
          "type": "number"
        },
        "gain_m": {
          "type": "number"
        },
        "avg_grade": {
          "type": "number"
        },
        "max_grade_500m": {
          "type": "number"
        },
        "top_m": {
          "description": "Elevation at the top",
          "type": "number"
        },
        "fiets": {
          "description": "FIETS climb difficulty index",
          "type": "number"
        },
        "direction": {
          "enum": [
            "forward",
            "reverse"
          ],
          "type": "string"
        }
      },
      "required": [
        "from_m",
        "to_m",
        "length_m",
        "gain_m",
        "avg_grade",
        "max_grade_500m",
        "top_m",
        "fiets",
        "direction"
      ],
      "type": "object",
      "title": "Climb"
    },
    "Component": {
      "description": "A continuous piece of a path. Gaps join two ride components and have zero measured length.",
      "properties": {
        "id": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "from_m": {
          "type": "number"
        },
        "to_m": {
          "type": "number"
        },
        "length_m": {
          "type": "number"
        },
        "straight_distance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For gaps: straight-line distance between the two ride ends"
        },
        "daily_section": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source daily section number (rides)"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "gap_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/GapType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For gaps: how the break is crossed"
        },
        "gap_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For gaps: what the classification rests on"
        },
        "gap_confidence": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "seq",
        "kind",
        "from_m",
        "to_m",
        "length_m",
        "straight_distance_m",
        "daily_section",
        "start",
        "end",
        "gap_type",
        "gap_basis",
        "gap_confidence"
      ],
      "type": "object",
      "title": "Component"
    },
    "ComponentKind": {
      "enum": [
        "ride",
        "gap"
      ],
      "type": "string",
      "title": "ComponentKind"
    },
    "Criterion": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "essential",
            "important"
          ],
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "tier",
        "description"
      ],
      "type": "object",
      "title": "Criterion"
    },
    "CriterionShare": {
      "properties": {
        "passed": {
          "type": "number"
        },
        "failed": {
          "type": "number"
        },
        "unknown": {
          "type": "number"
        }
      },
      "required": [
        "passed",
        "failed",
        "unknown"
      ],
      "type": "object",
      "title": "CriterionShare"
    },
    "CurrentPointer": {
      "properties": {
        "run_id": {
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "updated_at"
      ],
      "type": "object",
      "title": "CurrentPointer"
    },
    "DailySection": {
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "start_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "from_m": {
          "type": "number"
        },
        "to_m": {
          "type": "number"
        },
        "length_m": {
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/EuroVeloStatus"
        },
        "reversed_in_source": {
          "description": "Track was stored end-to-start in the source GPX",
          "type": "boolean"
        },
        "point_count": {
          "type": "integer"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "id",
        "number",
        "title",
        "start_name",
        "end_name",
        "from_m",
        "to_m",
        "length_m",
        "status",
        "reversed_in_source",
        "point_count",
        "start",
        "end"
      ],
      "type": "object",
      "title": "DailySection"
    },
    "DevelopmentLevel": {
      "enum": [
        "certified",
        "developed",
        "partially_developed",
        "undeveloped_unknown",
        "unrecognised"
      ],
      "type": "string",
      "title": "DevelopmentLevel"
    },
    "EuroVeloStatus": {
      "properties": {
        "development": {
          "$ref": "#/$defs/DevelopmentLevel"
        },
        "signage": {
          "$ref": "#/$defs/Signage"
        },
        "label": {
          "description": "Status label exactly as published, e.g. 'Developed + Signed'",
          "type": "string"
        }
      },
      "required": [
        "development",
        "signage",
        "label"
      ],
      "type": "object",
      "title": "EuroVeloStatus"
    },
    "Event": {
      "description": "One layer value over a stretch of the route (measures in metres on the path axis).",
      "properties": {
        "layer": {
          "type": "string"
        },
        "from_m": {
          "type": "number"
        },
        "to_m": {
          "type": "number"
        },
        "value": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        "detail": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "layer",
        "from_m",
        "to_m",
        "value",
        "confidence",
        "detail"
      ],
      "type": "object",
      "title": "Event"
    },
    "EventsFile": {
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/$defs/LayerInfo"
          },
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "layers",
        "events"
      ],
      "type": "object",
      "title": "EventsFile"
    },
    "Finding": {
      "properties": {
        "id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "data_quality",
            "route"
          ],
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "from_m": {
          "type": "number"
        },
        "to_m": {
          "type": "number"
        },
        "position": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Representative location for map display"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "type": "object"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "category",
        "severity",
        "from_m",
        "to_m",
        "position",
        "title",
        "detail",
        "evidence",
        "confidence"
      ],
      "type": "object",
      "title": "Finding"
    },
    "FindingsFile": {
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        }
      },
      "required": [
        "findings"
      ],
      "type": "object",
      "title": "FindingsFile"
    },
    "GapType": {
      "enum": [
        "ferry",
        "public_transport",
        "discontinuity",
        "missing",
        "unclassified"
      ],
      "type": "string",
      "title": "GapType"
    },
    "LayerInfo": {
      "description": "A family of events along the route (e.g. surface), with its allowed categorical values.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/LayerValue"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "source",
        "values"
      ],
      "type": "object",
      "title": "LayerInfo"
    },
    "LayerValue": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object",
      "title": "LayerValue"
    },
    "Licence": {
      "properties": {
        "id": {
          "description": "SPDX-style identifier, e.g. ODbL-1.0",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "url"
      ],
      "type": "object",
      "title": "Licence"
    },
    "MinorFile": {
      "properties": {
        "size_m": {
          "type": "number"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/MinorSection"
          },
          "type": "array"
        }
      },
      "required": [
        "size_m",
        "criteria",
        "sections"
      ],
      "type": "object",
      "title": "MinorFile"
    },
    "MinorSection": {
      "description": "One ECS minor section (1 km): dominant layer values and indicative criterion results.",
      "properties": {
        "index": {
          "type": "integer"
        },
        "from_m": {
          "type": "number"
        },
        "to_m": {
          "type": "number"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Layer id -> value covering most of this kilometre",
          "type": "object"
        },
        "criteria": {
          "additionalProperties": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ],
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "index",
        "from_m",
        "to_m",
        "values",
        "criteria"
      ],
      "type": "object",
      "title": "MinorSection"
    },
    "PipelineInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object",
      "title": "PipelineInfo"
    },
    "ProfileFile": {
      "description": "Elevation sampled along the path every `step_m`.\n\n`ele` is the audit's best estimate (smoothed DEM, bridges and tunnels interpolated) when a DEM was used,\notherwise the source GPX elevation. `gpx_ele` always holds the source GPX elevation for comparison.",
      "properties": {
        "step_m": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "m": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "ele": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "gpx_ele": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "step_m",
        "source",
        "m",
        "ele",
        "gpx_ele"
      ],
      "type": "object",
      "title": "ProfileFile"
    },
    "Route": {
      "properties": {
        "id": {
          "description": "Global route id, e.g. eurovelo:ev8",
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "ref": {
          "description": "Display reference, e.g. EV8",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "official_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "network",
        "ref",
        "name",
        "official_url"
      ],
      "type": "object",
      "title": "Route"
    },
    "RouteSummary": {
      "properties": {
        "ride_length_m": {
          "type": "number"
        },
        "daily_section_count": {
          "type": "integer"
        },
        "gap_count": {
          "type": "integer"
        },
        "gap_straight_distance_m": {
          "type": "number"
        },
        "status_breakdown": {
          "items": {
            "$ref": "#/$defs/StatusShare"
          },
          "type": "array"
        }
      },
      "required": [
        "ride_length_m",
        "daily_section_count",
        "gap_count",
        "gap_straight_distance_m",
        "status_breakdown"
      ],
      "type": "object",
      "title": "RouteSummary"
    },
    "ScoresFile": {
      "properties": {
        "rules_profile": {
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "route": {
          "$ref": "#/$defs/StretchStats"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionScores"
          },
          "type": "array"
        },
        "climbs": {
          "items": {
            "$ref": "#/$defs/Climb"
          },
          "type": "array"
        }
      },
      "required": [
        "rules_profile",
        "criteria",
        "route",
        "sections",
        "climbs"
      ],
      "type": "object",
      "title": "ScoresFile"
    },
    "SectionScores": {
      "properties": {
        "from_m": {
          "type": "number"
        },
        "to_m": {
          "type": "number"
        },
        "ascent_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "descent_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_grade_500m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Steepest 500 m average gradient (%) in travel direction"
        },
        "shares": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "description": "Layer id -> value -> share of length (0-1)",
          "type": "object"
        },
        "criteria": {
          "additionalProperties": {
            "$ref": "#/$defs/CriterionShare"
          },
          "type": "object"
        },
        "essential_pass": {
          "description": "Share of length meeting all essential criteria",
          "type": "number"
        },
        "important_pass": {
          "description": "Share of length meeting all important criteria",
          "type": "number"
        },
        "number": {
          "type": "integer"
        }
      },
      "required": [
        "from_m",
        "to_m",
        "ascent_m",
        "descent_m",
        "max_grade_500m",
        "shares",
        "criteria",
        "essential_pass",
        "important_pass",
        "number"
      ],
      "type": "object",
      "title": "SectionScores"
    },
    "SectionsFile": {
      "properties": {
        "daily": {
          "items": {
            "$ref": "#/$defs/DailySection"
          },
          "type": "array"
        },
        "status": {
          "items": {
            "$ref": "#/$defs/StatusSection"
          },
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "type": "array"
        },
        "blocks": {
          "description": "Fixed 50 km live-data blocks as [from_m, to_m]",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "array"
        },
        "minor": {
          "description": "Fixed 1 km ECS minor sections as [from_m, to_m]",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "daily",
        "status",
        "components",
        "blocks",
        "minor"
      ],
      "type": "object",
      "title": "SectionsFile"
    },
    "Severity": {
      "enum": [
        "info",
        "caution",
        "warning",
        "blocker"
      ],
      "type": "string",
      "title": "Severity"
    },
    "Signage": {
      "enum": [
        "signed",
        "not_signed",
        "unknown"
      ],
      "type": "string",
      "title": "Signage"
    },
    "SourceSnapshot": {
      "description": "One downloaded source file, with the provenance needed for attribution and reproducibility.",
      "properties": {
        "id": {
          "description": "Source identifier, e.g. eurovelo-gpx",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "type": "string"
        },
        "file": {
          "description": "Path relative to the data directory",
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "licence": {
          "$ref": "#/$defs/Licence"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "retrieved_at",
